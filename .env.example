APP_ENV=development
DATABASE_PATH=data/trading_agent.db
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generated automatically by scripts/dev.ps1; do not commit a real token.
LOCAL_API_TOKEN=

PAPER_TRADING_ONLY=true
LIVE_TRADING_ENABLED=false
ALLOW_LIVE_ORDER_ENDPOINTS=false

LOCAL_MODEL_DISCOVERY_ENABLED=true
LOCAL_MODEL_BASE_URLS=http://127.0.0.1:8080/v1,http://127.0.0.1:1919/v1,http://127.0.0.1:8081/v1
LOCAL_MODEL_ID=
MODEL_DISCOVERY_TIMEOUT_SECONDS=3
AI_REQUEST_TIMEOUT_SECONDS=300
# Max total generated tokens per response; includes reasoning and final answer.
AI_MAX_OUTPUT_TOKENS=8192
# Hard cap for reasoning tokens, leaving the remaining output budget for the final answer.
AI_REASONING_BUDGET_TOKENS=4096
AI_QUEUE_MAX_PENDING=100
INFERENCE_LOCK_PATH=.agent_inference.lock

HOSTED_FALLBACK_ENABLED=false
HOSTED_FALLBACK_ELIGIBLE=false
HOSTED_BASE_URL=
HOSTED_MODEL_ID=
HOSTED_API_KEY=

MARKET_PROVIDER=alpaca
MARKET_DATA_BASE_URL=https://data.alpaca.markets
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_FEED=iex
MARKET_SCAN_ENABLED=true
MARKET_SCAN_INTERVAL_SECONDS=300
MAX_STALE_DATA_SECONDS=600
WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA,TSLA,GOOGL,AMZN,META,AMD,MU
AUTONOMOUS_PAPER_TRADING_ENABLED=true
AUTONOMOUS_TRADING_SYMBOLS=AAPL,MSFT,NVDA,TSLA,GOOGL,AMZN,META,AMD,MU

# Optional RSS/Atom feeds; comma-separated HTTPS URLs, no default paid provider
NEWS_RSS_URLS=
ECONOMIC_EVENTS_RSS_URLS=
NEWS_FEED_TIMEOUT_SECONDS=8

PAPER_INITIAL_EQUITY=100000
RISK_PER_TRADE_PCT=0.25
DAILY_LOSS_LIMIT_PCT=1.0
MAX_OPEN_POSITIONS=5
MAX_POSITION_VALUE_PCT=10
MAX_GROSS_EXPOSURE_PCT=20
MIN_REWARD_RISK=1.0
MAX_ENTRY_DEVIATION_PCT=2.0
SIMULATED_SLIPPAGE_BPS=5
AUTO_PROMOTE_STRATEGIES=false
